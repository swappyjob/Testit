# Copy this file to ".env" and fill in values. The .env file is git-ignored.

# --- Database ----------------------------------------------------------------
# LOCAL dev: leave DATABASE_URL unset and use the individual vars below
# (these are the local defaults).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=testit

# PRODUCTION / managed Postgres: set a single connection string. When present it
# takes priority over the PG* vars above and SSL is enabled automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGSSLMODE=disable   # only if your DB is on a private network without SSL

# --- Runtime -----------------------------------------------------------------
# Set to "production" on your live host. Enables Secure cookies + trust proxy.
# NODE_ENV=production
# PORT=3000                       # most hosts inject PORT automatically
# UPLOAD_DIR=/data/uploads        # point at a persistent disk in production

# --- First-boot admin (production) -------------------------------------------
# On first start in a fresh database, an admin is created from these. Idempotent:
# if the email already exists it is left untouched (a redeploy won't reset it).
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=change-me-to-something-strong
# ADMIN_NAME=Administrator

# --- Email for "forgot password" (optional) ----------------------------------
# If these are not set, reset links are printed to the server console instead
# of being emailed (fine for local testing). Admin-generated links always work.
#
# Gmail example (needs 2-Step Verification + an App Password, NOT your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=you@gmail.com
